{
  "private": true,
  "name": "my-app",
  "version": "0.18.0",
  "description": "Authoritative voxel server built with Colyseus",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",

    "gen:townhall": "tsx src/tools/expand-ops.ts src/structures/town_hall.ops.json src/structures/town_hall.blocks.json",

    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",

    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",

  "devDependencies": {
    "@colyseus/loadtest": "^0.17.7",
    "@colyseus/sdk": "^0.17.17",
    "@colyseus/testing": "^0.17.10",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },

  "dependencies": {
    "@colyseus/schema": "^4.0.0",
    "@colyseus/tools": "^0.17.0",
    "colyseus": "^0.17.6",
    "express": "^4.18.2"
  }
}
